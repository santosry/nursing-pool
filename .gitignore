# --- Binários gerados (banco SQLite, RDS) ---
*.sqlite
*.db
# Permite apenas CSVs pequenos de métricas/importância no output/ml/
output/ml/*.rds
!output/ml/model_comparison.csv
!output/ml/group_shap_contribution.csv
!output/ml/group_permutation_auc.csv
!output/ml/shap_importance.csv

# --- RDS no cache ---
output/cache/*.rds

# --- Resumo expandido (não publicar no GitHub) ---
output/RESUMO_EXPANDIDO_*.md
output/RESUMO_EXPANDIDO_*.pdf

# --- CSVs gerados com dados em nível de paciente (modo real) ---
